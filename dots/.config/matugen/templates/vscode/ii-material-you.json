  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment", "string.comment"], "settings": { "foreground": "{{colors.outline.default.hex}}", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python", "keyword.other.using", "keyword.other.import", "variable.language", "variable.language.this", "variable.language.self", "variable.language.super"], "settings": { "foreground": "{{colors.primary.default.hex}}" } },
    { "scope": ["keyword.operator", "punctuation", "meta.brace", "meta.delimiter", "punctuation.separator", "punctuation.terminator", "punctuation.accessor"], "settings": { "foreground": "{{colors.on_surface_variant.default.hex}}" } },
    { "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"], "settings": { "foreground": "{{colors.code_green.default.hex}}" } },
    { "scope": ["constant.character.escape", "string.regexp", "constant.other.placeholder", "punctuation.definition.template-expression"], "settings": { "foreground": "{{colors.code_red.default.hex}}" } },
    { "scope": ["constant.numeric", "constant.language", "constant.language.boolean", "constant.other", "support.constant", "variable.other.constant", "variable.other.enummember", "keyword.other.unit"], "settings": { "foreground": "{{colors.code_orange.default.hex}}" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function", "variable.function"], "settings": { "foreground": "{{colors.code_blue.default.hex}}" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class", "storage.type.class", "entity.name.namespace", "entity.name.type.module"], "settings": { "foreground": "{{colors.code_yellow.default.hex}}" } },
    { "scope": ["variable", "variable.other", "meta.definition.variable"], "settings": { "foreground": "{{colors.on_surface.default.hex}}" } },
    { "scope": ["variable.parameter", "meta.parameter"], "settings": { "foreground": "{{colors.on_secondary_container.default.hex}}", "fontStyle": "italic" } },
    { "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.object-literal.key", "entity.name.tag.yaml", "support.type.property-name", "support.type.property-name.css", "support.type.vendored.property-name.css"], "settings": { "foreground": "{{colors.code_cyan.default.hex}}" } },
    { "scope": ["entity.name.tag", "meta.tag.sgml", "punctuation.definition.tag"], "settings": { "foreground": "{{colors.primary.default.hex}}" } },
    { "scope": ["entity.other.attribute-name", "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.other.attribute-name.pseudo-class.css"], "settings": { "foreground": "{{colors.code_magenta.default.hex}}", "fontStyle": "italic" } },
    { "scope": ["entity.name.decorator", "meta.decorator", "punctuation.decorator", "storage.type.annotation", "meta.preprocessor", "keyword.control.directive"], "settings": { "foreground": "{{colors.code_magenta.default.hex}}" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "{{colors.primary.default.hex}}", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "{{colors.code_blue.default.hex}}" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"], "settings": { "foreground": "{{colors.code_green.default.hex}}" } },
    { "scope": ["markup.quote"], "settings": { "foreground": "{{colors.on_surface_variant.default.hex}}", "fontStyle": "italic" } },
