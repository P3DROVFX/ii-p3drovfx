    { "scope": ["markup.deleted", "meta.diff.header.from-file"], "settings": { "foreground": "{{colors.code_red.default.hex}}" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "{{colors.code_yellow.default.hex}}" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "{{colors.error.default.hex}}" } },
    { "scope": ["invalid.deprecated"], "settings": { "foreground": "{{colors.error.default.hex}}", "fontStyle": "strikethrough" } }
