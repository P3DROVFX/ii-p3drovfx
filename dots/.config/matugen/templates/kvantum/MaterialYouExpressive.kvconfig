[%General]
author=illogical-impulse
comment=Material 3 Expressive, rendered by matugen from the wallpaper palette
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=false
attach_active_tab=false
mirror_doc_tabs=false
group_toolbar_buttons=false
toolbar_item_spacing=2
toolbar_interior_spacing=4
spread_progressbar=true
composite=true
menu_shadow_depth=6
tooltip_shadow_depth=7
spread_menuitems=false
splitter_width=1
scroll_width=8
scroll_arrows=false
scroll_min_extent=48
slider_width=12
slider_handle_width=20
slider_handle_length=24
tickless_slider_handle_size=24
center_toolbar_handle=true
check_size=22
textless_progressbar=false
progressbar_thickness=8
menubar_mouse_tracking=true
toolbutton_style=0
double_click=false
translucent_windows=false
blurring=false
popup_blurring=false
vertical_spin_indicators=false
spin_button_width=28
fill_rubberband=false
merge_menubar_with_toolbar=true
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=16
combo_as_lineedit=false
animate_states=true
button_contents_shift=false
combo_menu=true
hide_combo_checkboxes=true
combo_focus_rect=false
groupbox_top_label=true
inline_spin_indicators=true
joined_inactive_tabs=false
layout_spacing=6
layout_margin=8
scrollbar_in_view=true
transient_scrollbar=true
transient_groove=false
submenu_overlap=0
tooltip_delay=-1
tree_branch_line=false
no_window_pattern=false
opaque=kaffeine,kmplayer,subtitlecomposer,kdenlive,vlc,smplayer,smplayer2,avidemux,avidemux2_qt4,avidemux3_qt4,avidemux3_qt5,kamoso,QtCreator,VirtualBox,trojita,dragon,digikam
reduce_window_opacity=0
respect_DE=true
scrollable_menu=false
submenu_delay=150
no_inactiveness=false
reduce_menu_opacity=0
click_behavior=0
contrast=1.00
dialog_button_layout=0
intensity=1.00
saturation=1.00
shadowless_popup=false
drag_from_buttons=false
menu_blur_radius=0
tooltip_blur_radius=0
dark_titlebar=true

[GeneralColors]
window.color={{colors.surface_container.default.hex}}
base.color={{colors.surface.default.hex}}
alt.base.color={{colors.surface_container_low.default.hex}}
button.color={{colors.surface_container_high.default.hex}}
light.color={{colors.surface_container_highest.default.hex}}
mid.light.color={{colors.surface_container_high.default.hex}}
dark.color={{colors.surface_container_lowest.default.hex}}
mid.color={{colors.outline_variant.default.hex}}
highlight.color={{colors.secondary_container.default.hex}}
inactive.highlight.color={{colors.secondary_container.default.hex}}
text.color={{colors.on_surface.default.hex}}
window.text.color={{colors.on_surface.default.hex}}
button.text.color={{colors.on_surface.default.hex}}
disabled.text.color={{colors.outline.default.hex}}
tooltip.text.color={{colors.inverse_on_surface.default.hex}}
highlight.text.color={{colors.on_secondary_container.default.hex}}
link.color={{colors.primary.default.hex}}
link.visited.color={{colors.tertiary.default.hex}}
progress.indicator.text.color={{colors.on_surface.default.hex}}

[Hacks]
transparent_ktitle_label=true
transparent_dolphin_view=false
transparent_pcmanfm_sidepane=true
blur_translucent=false
transparent_menutitle=true
respect_darkness=true
kcapacitybar_as_progressbar=true
force_size_grip=false
iconless_pushbutton=false
iconless_menu=false
disabled_icon_opacity=50
lxqtmainmenu_iconsize=16
normal_default_pushbutton=true
single_top_toolbar=true
tint_on_mouseover=0
transparent_pcmanfm_view=false
no_selection_tint=true
transparent_arrow_button=true
middle_click_scroll=false
opaque_colors=false
kinetic_scrolling=false
scroll_jump_workaround=true
centered_forms=false
noninteger_translucency=false
style_vertical_toolbars=false
blur_only_active_window=false

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=10
frame.bottom=10
frame.left=10
frame.right=10
frame.expansion=200
interior=true
interior.element=button
indicator.element=arrow
indicator.size=16
text.normal.color={{colors.on_secondary_container.default.hex}}
text.focus.color={{colors.on_secondary_container.default.hex}}
text.press.color={{colors.on_secondary_container.default.hex}}
text.toggle.color={{colors.on_primary.default.hex}}
text.disabled.color={{colors.outline.default.hex}}
text.shadow=0
text.margin.top=0
text.margin.bottom=0
text.margin.left=6
text.margin.right=6
text.iconspacing=8
text.bold=false
min_height=+0.5font
min_width=+3font

[PanelButtonTool]
inherits=PanelButtonCommand
min_width=0

[ToolbarButton]
frame=true
frame.element=tbutton
interior.element=tbutton
frame.top=10
frame.bottom=10
frame.left=10
frame.right=10
frame.expansion=200
indicator.element=tarrow
indicator.size=16
text.normal.color={{colors.on_surface_variant.default.hex}}
text.focus.color={{colors.on_surface.default.hex}}
text.press.color={{colors.on_surface.default.hex}}
text.toggle.color={{colors.on_secondary_container.default.hex}}
text.bold=false
text.margin=2

