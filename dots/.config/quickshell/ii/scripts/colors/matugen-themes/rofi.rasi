/* Generated by Matugen from the ii catalog. Add `@import "matugen.rasi"` to your rofi theme. */
* {
    background: {{colors.surface_container.default.hex}};
    background-alt: {{colors.surface_container_high.default.hex}};
    foreground: {{colors.on_surface.default.hex}};
    foreground-alt: {{colors.on_surface_variant.default.hex}};
    selected: {{colors.primary.default.hex}};
    on-selected: {{colors.on_primary.default.hex}};
    active: {{colors.secondary_container.default.hex}};
    urgent: {{colors.error.default.hex}};
    border-color: {{colors.outline_variant.default.hex}};
}
