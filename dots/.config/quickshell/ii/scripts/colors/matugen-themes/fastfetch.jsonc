// Generated by Matugen. Changes are overwritten on palette updates.
// Three groups, one accent each: System = primary, Desktop = secondary,
// Hardware = tertiary. Labels sit in on_surface_variant, values in on_surface.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "auto",
    "color": {
      "1": "{{colors.primary.default.hex}}",
      "2": "{{colors.on_background.default.hex}}"
    },
    "padding": { "top": 0, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "{{colors.on_surface_variant.default.hex}}",
      "title": "{{colors.primary.default.hex}}",
      "output": "{{colors.on_surface.default.hex}}",
      "separator": "{{colors.outline.default.hex}}"
    },
    "key": { "width": 20 }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "{{colors.primary.default.hex}}",
        "at": "{{colors.outline.default.hex}}",
        "host": "{{colors.secondary.default.hex}}"
      }
    },
    "break",
    {
      "type": "os",
      "key": "{#{{colors.primary.default.hex}}}{#1}System{#}    {#{{colors.on_surface_variant.default.hex}}}os",
      "format": "{name} {version-id}"
    },
    { "type": "disk", "key": "          age", "folders": "/", "format": "{days} days" },
    { "type": "kernel", "key": "          kernel", "format": "{release}" },
    { "type": "uptime", "key": "          uptime" },
    {
      "type": "packages",
      "key": "          packages",
      "format": "{rpm} rpm, {flatpak-all} flatpak"
    },
    "break",
    {
      "type": "wm",
      "key": "{#{{colors.secondary.default.hex}}}{#1}Desktop{#}   {#{{colors.on_surface_variant.default.hex}}}wm",
      "format": "{pretty-name} {version}"
    },
    { "type": "shell", "key": "          shell", "format": "{pretty-name} {version}" },
    { "type": "terminal", "key": "          terminal", "format": "{pretty-name}" },
    "break",
    {
      "type": "host",
      "key": "{#{{colors.tertiary.default.hex}}}{#1}Hardware{#}  {#{{colors.on_surface_variant.default.hex}}}host",
      "format": "{name}"
    },
    { "type": "cpu", "key": "          cpu", "format": "{name} ({cores-logical})" },
    { "type": "gpu", "key": "          gpu", "format": "{name}" },
    { "type": "memory", "key": "          memory" },
    { "type": "disk", "key": "          disk", "folders": "/" },
    "break",
    {
      "type": "custom",
      "format": "{#{{colors.primary.default.hex}}}███{#{{colors.primary_container.default.hex}}}███  {#{{colors.secondary.default.hex}}}███{#{{colors.secondary_container.default.hex}}}███  {#{{colors.tertiary.default.hex}}}███{#{{colors.tertiary_container.default.hex}}}███  {#{{colors.surface_container_highest.default.hex}}}███{#{{colors.outline.default.hex}}}███"
    }
  ]
}
