 void QmlScanner::scanDir(const QDir& dir) {
-	if (this->scannedDirs.contains(dir)) return;
+	// QDir::operator== resolves both canonical paths on every comparison, which made
+	// this check O(dirs) filesystem walks per import. Resolve once and use a set.
+	auto key = dir.canonicalPath();
+	if (key.isEmpty()) key = dir.absolutePath();
+	if (this->scannedDirKeys.contains(key)) return;
+	this->scannedDirKeys.insert(key);
 	this->scannedDirs.push_back(dir);
 
 	const auto& path = dir.path();
@@ -124,7 +129,8 @@ void QmlScanner::scanDir(const QDir& dir) {
 }
 
 bool QmlScanner::scanQmlFile(const QString& path, bool& singleton, bool& internal) {
-	if (this->scannedFiles.contains(path)) return false;
+	if (this->scannedFileSet.contains(path)) return false;
+	this->scannedFileSet.insert(path);
 	this->scannedFiles.push_back(path);
 
 	qCDebug(logQmlScanner) << "Scanning qml file" << path;
