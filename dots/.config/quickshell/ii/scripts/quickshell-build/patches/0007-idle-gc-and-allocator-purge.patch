+#pragma once
+
+namespace qs::memtrim {
+
+// Starts the idle memory trimmer (once; later calls do nothing). Call on the GUI thread
+// after the QGuiApplication exists. QS_NO_IDLE_TRIM=1 leaves it off.
+void install();
+
+} // namespace qs::memtrim
